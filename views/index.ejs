<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bluesky Hashtag Trends</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        h1 {
            margin-bottom: 30px;
        }

        select {
            padding: 10px;
            font-size: 16px;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }
    </style>
</head>

<body>

    <h1>Bluesky Hashtag Trends</h1>

    <label for="categorySelect">
        <strong>Select a Category:</strong>
    </label>

    <select id="categorySelect">
        <option value="">All Categories</option>

        <% categories.forEach(item => { %>
            <option value="<%= item.category %>">
                <%= item.category %>
            </option>
        <% }); %>
    </select>

    <h2 id="tableTitle">Top 10 Hashtags</h2>

    <table>
        <thead>
            <tr>
                <th>Rank</th>
                <th>Hashtag</th>
                <th>Count</th>
                <th>Date</th>
            </tr>
        </thead>

        <tbody id="results">

            <% topHashtags.forEach((item, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td>#<%= item.hashtag %></td>
                    <td><%= item.total_count %></td>
                    <td>-</td>
                </tr>
            <% }); %>

        </tbody>
    </table>


    <script>
        const categorySelect =
            document.getElementById("categorySelect");

        const results =
            document.getElementById("results");

        const tableTitle =
            document.getElementById("tableTitle");


        categorySelect.addEventListener("change", async function () {

            const category = categorySelect.value;

            try {

                let url = "/api/trending?limit=10";

                if (category) {
                    url += "&category=" +
                        encodeURIComponent(category);
                }

                const response = await fetch(url);

                const data = await response.json();

                results.innerHTML = "";

                if (category) {
                    tableTitle.textContent =
                        "Top 10 Hashtags - " + category;
                } else {
                    tableTitle.textContent =
                        "Top 10 Hashtags";
                }

                if (data.length === 0) {
                    results.innerHTML =
                        "<tr><td colspan='4'>No results found.</td></tr>";
                    return;
                }

                data.forEach((item, index) => {

                    const row =
                        document.createElement("tr");

                    let date = "-";

                    if (item.post_date) {
                        date =
                            String(item.post_date).substring(0, 10);
                    }

                    row.innerHTML = `
                        <td>${index + 1}</td>
                        <td>#${item.hashtag}</td>
                        <td>${item.total_count}</td>
                        <td>${date}</td>
                    `;

                    results.appendChild(row);
                });

            } catch (error) {

                console.error(error);

                results.innerHTML =
                    "<tr><td colspan='4'>Error loading data.</td></tr>";
            }

        });
    </script>

</body>

</html>
