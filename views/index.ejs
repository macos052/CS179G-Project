<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bluesky Hashtag Trends</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        h1 {
            margin-bottom: 30px;
        }

        select {
            padding: 10px;
            font-size: 16px;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }
    
        button.viewPostsBtn {
            padding: 7px 12px;
            cursor: pointer;
        }

        .post-card {
            border: 1px solid #ddd;
            padding: 16px;
            margin: 12px 0;
            border-radius: 6px;
        }

        .post-author {
            font-weight: bold;
            margin-bottom: 6px;
        }

        .post-date {
            color: #666;
            font-size: 14px;
        }

        .post-text {
            white-space: pre-wrap;
            margin: 12px 0;
        }
    </style>
</head>

<body>

    <h1>Bluesky Hashtag Trends</h1>

    <label for="categorySelect">
        <strong>Select a Category:</strong>
    </label>

    <select id="categorySelect">
        <option value="">All Categories</option>

        <% categories.forEach(item => { %>
            <option value="<%= item.category %>">
                <%= item.category %>
            </option>
        <% }); %>
    </select>

    <br><br>

    <label for="dateSelect">
        <strong>Select a Date:</strong>
    </label>

    <select id="dateSelect">
        <option value="">All Dates</option>

        <% dates.forEach(item => { %>
            <% const date = new Date(item.post_date).toISOString().substring(0, 10); %>
            <option value="<%= date %>">
                <%= date %>
            </option>
        <% }); %>
    </select>

    <h2 id="tableTitle">Top 10 Hashtags</h2>

    <table>
        <thead>
            <tr>
                <th>Rank</th>
                <th>Hashtag</th>
                <th>Count</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="results">

            <% topHashtags.forEach((item, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td>#<%= item.hashtag %></td>
                    <td><%= item.total_count %></td>
                    <td>-</td>
                    <td>
                        <button
                            class="viewPostsBtn"
                            data-hashtag="<%= item.hashtag %>">
                            View Posts
                        </button>
                    </td>
                </tr>
            <% }); %>

        </tbody>
    </table>

    <hr style="margin-top: 50px;">

    <h2 id="postsTitle">Matching Posts</h2>

    <p id="postsMessage">
        Click "View Posts" next to a hashtag to see matching Bluesky posts.
    </p>

    <div id="postResults"></div>




    <hr style="margin-top: 50px;">

    
    <h2 id="trendTitle">Category Activity Over Time</h2>

    <p id="trendMessage">
        Select a category to view its recent activity trend.
    </p>

    <div style="max-width: 900px; height: 400px; margin-bottom: 50px;">
        <canvas id="trendChart"></canvas>
    </div>

    <h2>Category Popularity</h2>


    <label>
        <input type="checkbox" id="hideOther">
        Hide "Other"
    </label>

    <div style="max-width: 900px; height: 450px; margin-top: 20px;">
        <canvas id="categoryChart"></canvas>
    </div>

    <script src="/js/chart.umd.js"></script>

    <script>

        const categorySelect =
            document.getElementById("categorySelect");

        const dateSelect =
            document.getElementById("dateSelect");

        const results =
            document.getElementById("results");

        const tableTitle =
            document.getElementById("tableTitle");


        async function loadTrending() {

            const category = categorySelect.value;
            const postDate = dateSelect.value;

            try {

                let url = "/api/trending?limit=10";

                if (category) {
                    url += "&category=" +
                        encodeURIComponent(category);
                }

                if (postDate) {
                    url += "&postDate=" +
                        encodeURIComponent(postDate);
                }

                const response = await fetch(url);
                const data = await response.json();

                results.innerHTML = "";

                let title = "Top 10 Hashtags";

                if (category) {
                    title += " - " + category;
                }

                if (postDate) {
                    title += " - " + postDate;
                }

                tableTitle.textContent = title;

                if (data.length === 0) {
                    results.innerHTML =
                        "<tr><td colspan='5'>No results found.</td></tr>";
                    return;
                }

                data.forEach((item, index) => {

                    const row =
                        document.createElement("tr");

                    let date = "-";

                    if (item.post_date) {
                        date =
                            String(item.post_date).substring(0, 10);
                    }

                    row.innerHTML = `
                        <td>${index + 1}</td>
                        <td>#${item.hashtag}</td>
                        <td>${item.total_count}</td>
                        <td>${date}</td>
                        <td>
                            <button
                                class="viewPostsBtn"
                                data-hashtag="${item.hashtag}">
                                View Posts
                            </button>
                        </td>
                    `;

                    results.appendChild(row);
                });

            } catch (error) {

                console.error(error);

                results.innerHTML =
                    "<tr><td colspan='5'>Error loading data.</td></tr>";
            }
        }


        categorySelect.addEventListener(
            "change",
            async function () {
                await loadTrending();
                await loadCategoryTrend();
            }
        );

        dateSelect.addEventListener(
            "change",
            loadTrending
        );



        // ----------------------------
        // Category Popularity Chart
        // ----------------------------

        const hideOther =
            document.getElementById("hideOther");

        const categoryChartCanvas =
            document.getElementById("categoryChart");

        let categoryChart;
        let categoryTotals = [];


        async function loadCategoryChart() {

            const response =
                await fetch("/api/category-totals");

            categoryTotals =
                await response.json();

            drawCategoryChart();
        }


        function drawCategoryChart() {

            let chartData = categoryTotals;

            if (hideOther.checked) {
                chartData = categoryTotals.filter(
                    item => item.category !== "other"
                );
            }

            const labels =
                chartData.map(
                    item => item.category
                );

            const totals =
                chartData.map(
                    item => Number(item.total_activity)
                );

            if (categoryChart) {
                categoryChart.destroy();
            }

            categoryChart = new Chart(
                categoryChartCanvas,
                {
                    type: "bar",

                    data: {
                        labels: labels,

                        datasets: [{
                            label: "Total Activity",
                            data: totals
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        },

                        plugins: {
                            title: {
                                display: true,
                                text: "Total Hashtag Activity by Category"
                            }
                        }
                    }
                }
            );
        }


        hideOther.addEventListener(
            "change",
            drawCategoryChart
        );


        loadCategoryChart();



        // ----------------------------
        // Category Trend Line Chart
        // ----------------------------

        const trendChartCanvas =
            document.getElementById("trendChart");

        const trendTitle =
            document.getElementById("trendTitle");

        const trendMessage =
            document.getElementById("trendMessage");

        let trendChart;


        async function loadCategoryTrend() {

            const category = categorySelect.value;

            if (!category) {

                trendMessage.textContent =
                    "Select a category to view its recent activity trend.";

                trendTitle.textContent =
                    "Category Activity Over Time";

                if (trendChart) {
                    trendChart.destroy();
                    trendChart = null;
                }

                return;
            }

            const response = await fetch(
                "/api/category-trend?category=" +
                encodeURIComponent(category)
            );

            const data = await response.json();

            // Show only the most recent 30 dates
            const recentData = data.slice(-30);

            const labels = recentData.map(item =>
                String(item.post_date).substring(0, 10)
            );

            const activity = recentData.map(item =>
                Number(item.total_activity)
            );

            trendTitle.textContent =
                category + " Activity Over Time";

            trendMessage.textContent =
                "Showing the most recent 30 available dates.";

            if (trendChart) {
                trendChart.destroy();
            }

            trendChart = new Chart(
                trendChartCanvas,
                {
                    type: "line",

                    data: {
                        labels: labels,

                        datasets: [{
                            label: "Total Activity",
                            data: activity,
                            tension: 0.2
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: "Total Activity"
                                }
                            },

                            x: {
                                title: {
                                    display: true,
                                    text: "Date"
                                }
                            }
                        }
                    }
                }
            );
        }



        // ----------------------------
        // Show Matching Posts
        // ----------------------------

        const postsTitle =
            document.getElementById("postsTitle");

        const postsMessage =
            document.getElementById("postsMessage");

        const postResults =
            document.getElementById("postResults");


        async function loadMatchingPosts(hashtag) {

            const category = categorySelect.value;
            const postDate = dateSelect.value;

            let url =
                "/api/posts?hashtag=" +
                encodeURIComponent(hashtag) +
                "&limit=10";

            if (category) {
                url += "&category=" +
                    encodeURIComponent(category);
            }

            if (postDate) {
                url += "&postDate=" +
                    encodeURIComponent(postDate);
            }

            postsTitle.textContent =
                "Posts for #" + hashtag;

            postsMessage.textContent =
                "Loading matching posts...";

            postResults.innerHTML = "";

            try {

                const response = await fetch(url);
                const data = await response.json();

                if (!response.ok) {
                    throw new Error("Failed to load posts");
                }

                postsMessage.textContent =
                    data.length +
                    " matching post(s) shown.";

                if (data.length === 0) {
                    postResults.innerHTML =
                        "<p>No matching posts found.</p>";
                    return;
                }

                data.forEach(item => {

                    const card =
                        document.createElement("div");

                    card.className = "post-card";

                    const author =
                        document.createElement("div");

                    author.className = "post-author";
                    author.textContent =
                        "@" + (item.author_handle || "unknown");

                    const date =
                        document.createElement("div");

                    date.className = "post-date";
                    date.textContent =
                        item.post_date
                            ? String(item.post_date).substring(0, 10)
                            : "";

                    const postText =
                        document.createElement("div");

                    postText.className = "post-text";
                    postText.textContent =
                        item.post_text || "";

                    card.appendChild(author);
                    card.appendChild(date);
                    card.appendChild(postText);

                    if (item.uri && item.author_handle) {

                        const rkey =
                            item.uri.split("/").pop();

                        const link =
                            document.createElement("a");

                        link.href =
                            "https://bsky.app/profile/" +
                            encodeURIComponent(item.author_handle) +
                            "/post/" +
                            encodeURIComponent(rkey);

                        link.target = "_blank";
                        link.rel = "noopener noreferrer";
                        link.textContent = "View on Bluesky";

                        card.appendChild(link);
                    }

                    postResults.appendChild(card);
                });

            } catch(error) {

                console.error(error);

                postsMessage.textContent =
                    "Error loading posts.";
            }
        }


        results.addEventListener("click", function(event) {

            const button =
                event.target.closest(".viewPostsBtn");

            if (!button) {
                return;
            }

            loadMatchingPosts(
                button.dataset.hashtag
            );
        });

    </script>

</body>

</html>